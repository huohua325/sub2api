# Load into the MILE backend. Empty/unset values leave the native route disabled.
# This HTTPS host must be dedicated to the protected workspace.
DEV_T3_NATIVE_PUBLIC_URL=https://workbench.example.com
DEV_T3_NATIVE_ADMIN_ORIGIN=https://admin.example.com
# Private upstream origin as seen from the MILE backend.
DEV_T3_NATIVE_UPSTREAM_URL=http://127.0.0.1:3773
# Set for the same-host Unix socket relay. Leave unset for HTTPS or a tunnel.
DEV_T3_NATIVE_UPSTREAM_SOCKET_FILE=/run/mile-t3-gateway/t3.sock
DEV_T3_NATIVE_PAIR_TOKEN_FILE=/run/secrets/mile-t3-native-pair
# The on-host Compose example consumes these two additional variables.
# DEV_T3_NATIVE_SOCKET_GID=
# DEV_T3_NATIVE_PAIR_TOKEN_HOST_FILE=
